<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>TimeSpeak — Chamada + Compartilhar Tela</title>
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
  :root {
    --bg: #0e0f13;
    --panel: #16181f;
    --panel-2: #1e2129;
    --accent: #7c5cff;
    --accent-2: #4ade80;
    --danger: #ff5c5c;
    --text: #e9e9ee;
    --muted: #8b8d98;
    --border: #2a2d38;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: radial-gradient(circle at 20% 0%, #1a1730 0%, var(--bg) 45%);
    color: var(--text);
    min-height: 100vh;
  }
  .container { max-width: 1100px; margin: 0 auto; padding: 24px 16px 60px; }
  header { text-align: center; margin-bottom: 28px; }
  header h1 {
    font-size: 26px;
    margin: 0 0 6px;
    background: linear-gradient(90deg, var(--accent), #a78bfa);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 700;
  }
  header p { color: var(--muted); font-size: 14px; margin: 0; }

  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px;
  }

  .lobby { max-width: 460px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
  .lobby label { font-size: 13px; color: var(--muted); }
  .lobby input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    color: var(--text);
    font-size: 15px;
    margin-top: 6px;
  }
  .row { display: flex; gap: 10px; }
  .row > * { flex: 1; }

  button {
    cursor: pointer;
    border: none;
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 600;
    transition: transform .08s ease, opacity .15s ease;
  }
  button:active { transform: scale(0.97); }
  .btn-primary { background: linear-gradient(90deg, var(--accent), #9575ff); color: white; }
  .btn-secondary { background: var(--panel-2); color: var(--text); border: 1px solid var(--border); }
  .btn-danger { background: var(--danger); color: white; }
  .btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
  button:disabled { opacity: 0.4; cursor: not-allowed; }

  .hidden { display: none !important; }

  .room-bar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 18px; flex-wrap: wrap; gap: 10px;
  }
  .room-code {
    font-family: monospace; font-size: 15px; background: var(--panel-2);
    padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border);
    letter-spacing: 1px;
  }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-2); display: inline-block; margin-right: 6px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
    margin-bottom: 20px;
  }
  .tile {
    background: #000;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--border);
  }
  .tile video { width: 100%; height: 100%; object-fit: cover; background: #000; }
  .tile .label {
    position: absolute; bottom: 8px; left: 10px;
    font-size: 12px; background: rgba(0,0,0,0.55);
    padding: 3px 9px; border-radius: 20px;
  }
  .tile.screen video { object-fit: contain; background: #0a0a0a; }

  .maximize-btn, .fullscreen-btn {
    position: absolute; top: 8px;
    width: 32px; height: 32px; padding: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.55); color: white;
    border-radius: 8px; font-size: 15px;
    opacity: 0; transition: opacity .15s ease;
  }
  .maximize-btn { right: 8px; }
  .fullscreen-btn { right: 48px; }
  .tile:hover .maximize-btn,
  .tile:hover .fullscreen-btn { opacity: 1; }

  .vol-wrap {
    position: absolute; left: 8px; right: 8px; bottom: 34px;
    display: flex; align-items: center; gap: 6px;
    opacity: 0; transition: opacity .15s ease;
  }
  .vol-wrap span { font-size: 12px; }
  .vol-wrap input[type=range] { flex: 1; accent-color: var(--accent); height: 4px; }
  .tile:hover .vol-wrap,
  .tile.expanded .vol-wrap { opacity: 1; }

  .kick-btn {
    position: absolute; top: 8px; left: 8px;
    width: 32px; height: 32px; padding: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,92,92,0.85); color: white;
    border-radius: 8px; font-size: 14px;
    opacity: 0; transition: opacity .15s ease;
  }
  .tile:hover .kick-btn,
  .tile.expanded .kick-btn { opacity: 1; }

  .grid.has-expanded { grid-template-columns: 1fr; }
  .grid.has-expanded .tile:not(.expanded) { display: none; }
  .tile.expanded {
    aspect-ratio: unset;
    height: min(78vh, 640px);
  }
  .tile.expanded video { object-fit: contain; background: #0a0a0a; }
  .tile.expanded .maximize-btn,
  .tile.expanded .fullscreen-btn { opacity: 1; }

  /* Tela cheia real (Fullscreen API) */
  .tile:fullscreen,
  .tile:-webkit-full-screen {
    aspect-ratio: unset;
    width: 100vw;
    height: 100vh;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tile:fullscreen video,
  .tile:-webkit-full-screen video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .tile:fullscreen .maximize-btn,
  .tile:-webkit-full-screen .maximize-btn { display: none; }
  .tile:fullscreen .fullscreen-btn,
  .tile:-webkit-full-screen .fullscreen-btn {
    right: 8px;
    opacity: 1;
  }

  .controls {
    display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;
    padding-top: 10px; border-top: 1px solid var(--border);
  }
  .controls button { min-width: 130px; }

  .toast {
    position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
    background: var(--panel-2); border: 1px solid var(--border);
    padding: 10px 18px; border-radius: 30px; font-size: 13px; color: var(--muted);
    box-shadow: 0 6px 24px rgba(0,0,0,0.4);
    max-width: 90vw;
    text-align: center;
  }
  .hint { font-size: 12px; color: var(--muted); text-align: center; margin-top: 10px; line-height: 1.5; }

  .conn-badge {
    position: absolute; top: 8px; right: 88px;
    font-size: 10px; padding: 3px 7px; border-radius: 6px;
    background: rgba(0,0,0,0.55); color: var(--muted);
    opacity: 0; transition: opacity .15s ease;
  }
  .tile:hover .conn-badge, .tile.expanded .conn-badge { opacity: 1; }
</style>
</head>
<body>
<div class="container">
  <header>
    <h1>TimeSpeak</h1>
    <p>Chamada de voz/vídeo + compartilhamento de tela entre amigos, direto no navegador.</p>
  </header>

  <!-- LOBBY -->
  <div id="lobby" class="card lobby">
    <div>
      <label>Seu nome (aparece pros outros na chamada)</label>
      <input id="nameInput" placeholder="ex: João" maxlength="20" />
    </div>

    <button class="btn-primary" id="createBtn">Criar sala nova</button>

    <div style="text-align:center; color:var(--muted); font-size:12px;">— ou —</div>

    <div>
      <label>Código da sala de um amigo</label>
      <input id="roomInput" placeholder="cole o código aqui" />
    </div>
    <button class="btn-secondary" id="joinBtn">Entrar na sala</button>

    <p class="hint">Preencha seu nome antes de criar ou entrar. Todos precisam liberar acesso ao microfone (e câmera, se quiserem).</p>
  </div>

  <!-- ROOM -->
  <div id="room" class="card hidden">
    <div class="room-bar">
      <div><span class="status-dot"></span>Conectado como <b id="myNameLabel"></b></div>
      <div>
        Código da sala:
        <span class="room-code" id="roomCodeLabel"></span>
        <button class="btn-ghost" id="copyBtn" style="margin-left:6px; padding:8px 12px;">Copiar</button>
      </div>
    </div>

    <div class="grid" id="videoGrid"></div>

    <div class="controls">
      <button class="btn-secondary" id="micBtn">🎤 Mudo</button>
      <button class="btn-secondary" id="camBtn">📷 Câmera</button>
      <button class="btn-primary" id="screenBtn">🖥️ Compartilhar tela</button>
      <button class="btn-danger" id="leaveBtn">Sair da sala</button>
    </div>
    <p class="hint">Compartilhando a tela? Só clicar em "Compartilhar tela" de novo pra parar e voltar pra câmera.<br>Passe o mouse num vídeo: ⛶ maximiza dentro da página, ⤢ abre em tela cheia de verdade.</p>
  </div>
</div>

<div id="toast" class="toast hidden"></div>

<script>
const $ = (id) => document.getElementById(id);
let peer, localStream, screenStream, myName, roomId, isHost = false;
const calls = {};      // peerId -> MediaConnection
const dataConns = {};  // peerId -> DataConnection
const knownPeers = new Set(); // peerIds in room (host maintains authoritative list)
const peerNames = {}; // peerId -> display name
let camOn = false, micOn = false, sharingScreen = false;

function toast(msg, ms = 2500) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.remove('hidden');
  clearTimeout(t._timer);
  t._timer = setTimeout(() => t.classList.add('hidden'), ms);
}

function genRoomCode() {
  return Math.random().toString(36).substring(2, 8).toUpperCase();
}

async function getLocalStream() {
  try {
    return await navigator.mediaDevices.getUserMedia({ audio: true, video: true });
  } catch (e) {
    toast('Sem câmera disponível, entrando só com áudio.');
    return await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
  }
}

function addTile(id, stream, label, isScreen = false, hasAudio = null) {
  removeTile(id + (isScreen ? '-screen' : ''));
  const tile = document.createElement('div');
  tile.className = 'tile' + (isScreen ? ' screen' : '');
  const tileId = id + (isScreen ? '-screen' : '');
  tile.id = 'tile-' + tileId;
  const video = document.createElement('video');
  video.autoplay = true;
  video.playsInline = true;
  video.volume = 1;
  if (id === 'me') video.muted = true;
  video.srcObject = stream;
  video.play().catch(err => console.warn('play() falhou (tile ' + tileId + '):', err));
  video.ondblclick = () => toggleExpand(tileId);
  const lbl = document.createElement('div');
  lbl.className = 'label';
  lbl.textContent = label;
  const maxBtn = document.createElement('button');
  maxBtn.className = 'maximize-btn';
  maxBtn.title = 'Maximizar na página';
  maxBtn.textContent = '⛶';
  maxBtn.onclick = (e) => { e.stopPropagation(); toggleExpand(tileId); };
  const fsBtn = document.createElement('button');
  fsBtn.className = 'fullscreen-btn';
  fsBtn.title = 'Tela cheia';
  fsBtn.textContent = '⤢';
  fsBtn.onclick = (e) => { e.stopPropagation(); toggleFullscreen(tile, fsBtn); };
  tile.appendChild(video);
  tile.appendChild(lbl);
  tile.appendChild(maxBtn);
  tile.appendChild(fsBtn);

  if (id !== 'me') {
    const badge = document.createElement('div');
    badge.className = 'conn-badge';
    badge.id = 'badge-' + tileId;
    badge.textContent = '';
    tile.appendChild(badge);
  }

  // Selo de áudio na tile de tela: deixa bem claro se o compartilhamento
  // veio com som ou não, pra não ficar procurando "por que não ouço".
  if (isScreen && hasAudio !== null) {
    const audioBadge = document.createElement('div');
    audioBadge.style.cssText = 'position:absolute; top:8px; left:48px; font-size:11px; padding:3px 8px; border-radius:6px; background:rgba(0,0,0,0.6);';
    audioBadge.textContent = hasAudio ? '🔊 com áudio' : '🔇 sem áudio';
    audioBadge.style.color = hasAudio ? 'var(--accent-2)' : 'var(--danger)';
    tile.appendChild(audioBadge);
  }

  if (id !== 'me' && (!isScreen || hasAudio)) {
    const volWrap = document.createElement('div');
    volWrap.className = 'vol-wrap';
    const volIcon = document.createElement('span');
    volIcon.textContent = '🔊';
    const volSlider = document.createElement('input');
    volSlider.type = 'range';
    volSlider.min = '0';
    volSlider.max = '100';
    volSlider.value = '100';
    volSlider.oninput = () => { video.volume = volSlider.value / 100; };
    volWrap.appendChild(volIcon);
    volWrap.appendChild(volSlider);
    tile.appendChild(volWrap);
  }

  if (id !== 'me' && !isScreen && isHost) {
    const kickBtn = document.createElement('button');
    kickBtn.className = 'kick-btn';
    kickBtn.title = 'Remover da sala';
    kickBtn.textContent = '⛔';
    kickBtn.onclick = (e) => {
      e.stopPropagation();
      if (!confirm('Remover ' + label + ' da sala?')) return;
      const conn = dataConns[id];
      if (conn && conn.open) conn.send({ type: 'kick' });
      if (calls[id]) { calls[id].close(); delete calls[id]; }
      if (conn) conn.close();
      delete dataConns[id];
      knownPeers.delete(id);
      removeTile(id);
    };
    tile.appendChild(kickBtn);
  }

  $('videoGrid').appendChild(tile);
}

function removeTile(id) {
  const el = document.getElementById('tile-' + id);
  if (el) {
    if (el.classList.contains('expanded')) $('videoGrid').classList.remove('has-expanded');
    el.remove();
  }
}

function toggleExpand(tileId) {
  const grid = $('videoGrid');
  const tile = document.getElementById('tile-' + tileId);
  if (!tile) return;
  const alreadyExpanded = tile.classList.contains('expanded');
  grid.querySelectorAll('.tile.expanded').forEach(t => {
    t.classList.remove('expanded');
    t.querySelector('.maximize-btn').textContent = '⛶';
  });
  if (!alreadyExpanded) {
    tile.classList.add('expanded');
    tile.querySelector('.maximize-btn').textContent = '✕';
    grid.classList.add('has-expanded');
  } else {
    grid.classList.remove('has-expanded');
  }
}

function toggleFullscreen(tile, fsBtn) {
  const fsEl = document.fullscreenElement || document.webkitFullscreenElement;
  if (!fsEl) {
    const req = tile.requestFullscreen || tile.webkitRequestFullscreen || tile.msRequestFullscreen;
    if (!req) return toast('Seu navegador não suporta tela cheia.');
    req.call(tile).catch(() => toast('Não foi possível entrar em tela cheia.'));
  } else {
    const exit = document.exitFullscreen || document.webkitExitFullscreen || document.msExitFullscreen;
    if (exit) exit.call(document);
  }
}

document.addEventListener('fullscreenchange', updateFullscreenIcons);
document.addEventListener('webkitfullscreenchange', updateFullscreenIcons);

function updateFullscreenIcons() {
  const fsEl = document.fullscreenElement || document.webkitFullscreenElement;
  document.querySelectorAll('.fullscreen-btn').forEach(btn => btn.textContent = '⤢');
  if (fsEl) {
    const btn = fsEl.querySelector('.fullscreen-btn');
    if (btn) btn.textContent = '✕';
  }
}

function getSendStream() {
  if (sharingScreen && screenStream) {
    const s = new MediaStream();
    localStream.getAudioTracks().forEach(t => s.addTrack(t));
    screenStream.getVideoTracks().forEach(t => s.addTrack(t));
    return s;
  }
  return localStream;
}

// ICE config: STUN + múltiplos TURN de fallback.
// O TURN é essencial quando um lado está atrás de NAT/firewall restritivo
// (comum em redes de PC/empresa) e a conexão P2P direta não fecha.
const ICE_CONFIG = {
  iceServers: [
    { urls: 'stun:stun.l.google.com:19302' },
    { urls: 'stun:stun1.l.google.com:19302' },
    { urls: 'turn:openrelay.metered.ca:80', username: 'openrelayproject', credential: 'openrelayproject' },
    { urls: 'turn:openrelay.metered.ca:443', username: 'openrelayproject', credential: 'openrelayproject' },
    { urls: 'turn:openrelay.metered.ca:443?transport=tcp', username: 'openrelayproject', credential: 'openrelayproject' }
  ],
  iceCandidatePoolSize: 4
};

async function initPeer(id) {
  return new Promise((resolve, reject) => {
    peer = new Peer(id, {
      debug: 1,
      config: ICE_CONFIG
    });
    peer.on('open', (pid) => resolve(pid));
    peer.on('error', (err) => {
      console.error(err);
      toast('Erro: ' + err.type);
      reject(err);
    });
  });
}

// screenCallsOut: chamadas que EU abro pra enviar minha tela pra cada peer
// screenCallsIn: chamadas de tela que EU recebo de cada peer
const screenCallsOut = {};
const screenCallsIn = {};

function setupIncomingHandlers() {
  peer.on('call', (call) => {
    if (call.metadata?.kind === 'screen') {
      // Chamada dedicada de compartilhamento de tela: eu só recebo, não envio nada.
      call.answer();
      handleScreenCall(call);
    } else {
      call.answer(getSendStream());
      handleCall(call);
    }
  });

  peer.on('connection', (conn) => {
    setupDataConn(conn);
  });
}

const remoteStreams = {}; // peerId -> MediaStream

function watchConnectionState(call, badgeTileId) {
  // Ajuda a diagnosticar: mostra no console e num badge discreto
  // se a conexão ficou "relay" (TURN) ou direta (host/srflx).
  const pc = call.peerConnection;
  if (!pc) return;
  pc.oniceconnectionstatechange = () => {
    console.log('[ICE] ' + badgeTileId + ':', pc.iceConnectionState);
    if (pc.iceConnectionState === 'connected' || pc.iceConnectionState === 'completed') {
      pc.getStats(null).then(stats => {
        stats.forEach(report => {
          if (report.type === 'candidate-pair' && report.state === 'succeeded' && report.nominated) {
            const localCand = stats.get(report.localCandidateId);
            const type = localCand ? localCand.candidateType : '?';
            const badge = document.getElementById('badge-' + badgeTileId);
            if (badge) badge.textContent = type === 'relay' ? '↻ relay (TURN)' : '● direto';
            console.log('[ICE pair] ' + badgeTileId + ' via', type);
          }
        });
      }).catch(() => {});
    }
  };
}

function handleCall(call) {
  calls[call.peer] = call;
  watchConnectionState(call, call.peer);
  call.on('stream', (remoteStream) => {
    remoteStreams[call.peer] = remoteStream;
    addTile(call.peer, remoteStream, peerNames[call.peer] || call.metadata?.name || 'Convidado');
  });
  call.on('close', () => {
    removeTile(call.peer);
    delete calls[call.peer];
    delete remoteStreams[call.peer];
  });
  call.on('error', (err) => console.error('[call error]', call.peer, err));
}

function handleScreenCall(call) {
  screenCallsIn[call.peer] = call;
  watchConnectionState(call, call.peer + '-screen');
  call.on('stream', (remoteStream) => {
    const hasAudio = remoteStream.getAudioTracks().length > 0;
    console.log('[screen stream] de ' + call.peer + ' — áudio:', hasAudio ? 'sim (' + remoteStream.getAudioTracks().length + ' track)' : 'NÃO veio nenhuma track de áudio');
    remoteStream.getAudioTracks().forEach(t => {
      console.log('  audio track:', t.label, '| enabled:', t.enabled, '| muted:', t.muted, '| readyState:', t.readyState);
      t.onmute = () => console.log('  [audio track mutou]', call.peer);
      t.onunmute = () => console.log('  [audio track desmutou]', call.peer);
    });
    addTile(call.peer, remoteStream, peerNames[call.peer] || call.metadata?.name || 'Convidado', true, hasAudio);
  });
  call.on('close', () => {
    removeTile(call.peer + '-screen');
    delete screenCallsIn[call.peer];
  });
  call.on('error', (err) => console.error('[screen call error]', call.peer, err));
}

function limitVideoBitrate(call, maxBitrate) {
  const pc = call.peerConnection;
  if (!pc) return;
  const trySet = () => {
    const sender = pc.getSenders().find(s => s.track && s.track.kind === 'video');
    if (!sender) return;
    const params = sender.getParameters();
    if (!params.encodings || params.encodings.length === 0) params.encodings = [{}];
    params.encodings[0].maxBitrate = maxBitrate;
    params.encodings[0].scaleResolutionDownBy = 1; // não deixa o navegador reduzir a resolução sozinho
    params.degradationPreference = 'maintain-resolution'; // prioriza nitidez/resolução em vez de cair fps
    sender.setParameters(params).catch(err => console.warn('setParameters falhou:', err));
  };
  trySet();
  setTimeout(trySet, 500); // reforço caso o sender ainda não existisse na 1ª tentativa
}

function startScreenCallToPeer(peerId) {
  if (!screenStream) return;
  const tracks = [...screenStream.getVideoTracks(), ...screenStream.getAudioTracks()];
  const outStream = new MediaStream(tracks);
  const call = peer.call(peerId, outStream, { metadata: { name: myName, kind: 'screen' } });
  screenCallsOut[peerId] = call;
  call.on('error', (err) => console.error('[screen call out error]', peerId, err));
  call.on('close', () => { delete screenCallsOut[peerId]; });
  limitVideoBitrate(call, 6_000_000); // ~6 Mbps, dá pra 1080p/30fps sem ficar blocado
}

function connectToPeer(remoteId) {
  if (remoteId === peer.id || calls[remoteId]) return;
  const call = peer.call(remoteId, getSendStream(), { metadata: { name: myName } });
  handleCall(call);

  const conn = peer.connect(remoteId, { metadata: { name: myName } });
  setupDataConn(conn);
}

function setupDataConn(conn) {
  dataConns[conn.peer] = conn;
  if (conn.metadata?.name) peerNames[conn.peer] = conn.metadata.name;

  conn.on('open', () => {
    conn.send({ type: 'hello', name: myName });
    knownPeers.add(conn.peer);

    if (isHost) {
      // send current peer list to the new joiner
      conn.send({ type: 'peer-list', peers: [...knownPeers].filter(p => p !== conn.peer) });
      // tell everyone else about the newcomer
      broadcastExcept(conn.peer, { type: 'new-peer', peerId: conn.peer });
    }

    // Se eu já estiver compartilhando tela, manda pro peer que acabou de conectar também.
    if (sharingScreen && !screenCallsOut[conn.peer]) {
      startScreenCallToPeer(conn.peer);
    }
  });

  conn.on('data', (data) => {
    if (data.type === 'peer-list') {
      data.peers.forEach(pid => {
        knownPeers.add(pid);
        connectToPeer(pid);
      });
    } else if (data.type === 'new-peer') {
      knownPeers.add(data.peerId);
    } else if (data.type === 'hello') {
      peerNames[conn.peer] = data.name;
      const lbl = document.querySelector('#tile-' + conn.peer + ' .label');
      if (lbl) lbl.textContent = data.name;
    } else if (data.type === 'kick') {
      if (conn.peer === roomId) {
        toast('Você foi removido da sala pelo host.', 4000);
        leaveRoom();
        setTimeout(() => location.reload(), 1200);
      }
    } else if (data.type === 'bye') {
      removeTile(conn.peer);
      removeTile(conn.peer + '-screen');
      if (calls[conn.peer]) { calls[conn.peer].close(); delete calls[conn.peer]; }
      if (screenCallsIn[conn.peer]) { screenCallsIn[conn.peer].close(); delete screenCallsIn[conn.peer]; }
      if (screenCallsOut[conn.peer]) { screenCallsOut[conn.peer].close(); delete screenCallsOut[conn.peer]; }
    }
  });

  conn.on('close', () => {
    delete dataConns[conn.peer];
    knownPeers.delete(conn.peer);
    removeTile(conn.peer);
    removeTile(conn.peer + '-screen');
  });
}

function broadcastExcept(exceptId, msg) {
  Object.values(dataConns).forEach(c => {
    if (c.peer !== exceptId && c.open) c.send(msg);
  });
}

function getValidName() {
  const name = $('nameInput').value.trim();
  if (!name) {
    toast('Digite seu nome antes de continuar.');
    $('nameInput').focus();
    return null;
  }
  return name;
}

async function enterRoom(code, hosting) {
  roomId = code;
  isHost = hosting;

  localStream = await getLocalStream();
  localStream.getAudioTracks().forEach(t => t.enabled = false);
  localStream.getVideoTracks().forEach(t => t.enabled = false);
  $('micBtn').textContent = '🔇 Mutado';
  $('camBtn').textContent = '📷 Desligada';

  const myId = hosting ? code : (code + '-' + Math.random().toString(36).substring(2, 8));
  await initPeer(myId);
  setupIncomingHandlers();

  if (!hosting) {
    const conn = peer.connect(code, { metadata: { name: myName } });
    setupDataConn(conn);
    const call = peer.call(code, getSendStream(), { metadata: { name: myName } });
    handleCall(call);
  }

  knownPeers.add(peer.id);

  $('lobby').classList.add('hidden');
  $('room').classList.remove('hidden');
  $('myNameLabel').textContent = myName;
  $('roomCodeLabel').textContent = roomId;
  addTile('me', localStream, myName + ' (você)');
}

$('createBtn').onclick = async () => {
  myName = getValidName();
  if (!myName) return;
  try { await enterRoom(genRoomCode(), true); }
  catch (e) { toast('Não foi possível criar a sala: ' + (e.message || e.name || e) + '. Se estiver num navegador dentro de outro app (Instagram, TikTok etc.), abra no Chrome/Safari.', 6000); }
};

$('joinBtn').onclick = async () => {
  myName = getValidName();
  if (!myName) return;
  const code = $('roomInput').value.trim().toUpperCase();
  if (!code) return toast('Cole o código da sala primeiro.');
  try { await enterRoom(code, false); }
  catch (e) { toast('Não foi possível entrar: ' + (e.message || e.name || e) + '. Se estiver num navegador dentro de outro app (Instagram, TikTok etc.), abra no Chrome/Safari.', 6000); }
};

$('copyBtn').onclick = () => {
  navigator.clipboard.writeText(roomId);
  toast('Código copiado!');
};

$('micBtn').onclick = () => {
  micOn = !micOn;
  localStream.getAudioTracks().forEach(t => t.enabled = micOn);
  $('micBtn').textContent = micOn ? '🎤 Mudo' : '🔇 Mutado';
};

$('camBtn').onclick = () => {
  if (sharingScreen) return toast('Pare o compartilhamento de tela primeiro.');
  camOn = !camOn;
  localStream.getVideoTracks().forEach(t => t.enabled = camOn);
  $('camBtn').textContent = camOn ? '📷 Câmera' : '📷 Desligada';
};

$('screenBtn').onclick = async () => {
  if (!sharingScreen) {
    try {
      // Pede vídeo + áudio. O áudio só vem se o usuário marcar a opção
      // "Compartilhar áudio" na caixa de diálogo do navegador (aparece ao
      // escolher uma aba, ou uma janela/tela inteira em navegadores que suportam).
      screenStream = await navigator.mediaDevices.getDisplayMedia({
        video: {
          width: { ideal: 1920, max: 1920 },
          height: { ideal: 1080, max: 1080 },
          frameRate: { ideal: 30, max: 60 }
        },
        audio: {
          echoCancellation: false,
          noiseSuppression: false,
          autoGainControl: false
        }
      });
    } catch (e) {
      return toast('Compartilhamento cancelado.');
    }
    const screenTrack = screenStream.getVideoTracks()[0];
    // Dá uma dica pro encoder priorizar movimento fluido (bom pra jogos/vídeo)
    // em vez de nitidez estática de texto.
    try { screenTrack.contentHint = 'motion'; } catch (e) {}

    if (screenStream.getAudioTracks().length === 0) {
      toast('Tela compartilhada sem áudio. Pra mandar o som junto, marque "Compartilhar áudio" na caixa do navegador (funciona melhor compartilhando uma aba do Chrome).', 6000);
    }

    sharingScreen = true;

    // Abre uma chamada NOVA e dedicada pra tela com cada peer já conectado,
    // em vez de reaproveitar (replaceTrack) a chamada de câmera. Isso evita
    // o bug de tela preta que acontece quando se troca a track de uma
    // chamada já em andamento sem renegociação completa.
    Object.keys(dataConns).forEach(peerId => startScreenCallToPeer(peerId));

    addTile('me', screenStream, myName + ' (sua tela)', true, screenStream.getAudioTracks().length > 0);
    document.getElementById('tile-me').classList.add('hidden');

    screenTrack.onended = () => stopScreenShare();
    $('screenBtn').textContent = '🛑 Parar compartilhamento';
  } else {
    stopScreenShare();
  }
};

function stopScreenShare() {
  if (!sharingScreen) return;
  Object.values(screenCallsOut).forEach(call => call.close());
  for (const k in screenCallsOut) delete screenCallsOut[k];
  if (screenStream) screenStream.getTracks().forEach(t => t.stop());
  removeTile('me-screen');
  document.getElementById('tile-me').classList.remove('hidden');
  sharingScreen = false;
  $('screenBtn').textContent = '🖥️ Compartilhar tela';
}

function leaveRoom() {
  Object.values(dataConns).forEach(c => { if (c.open) c.send({ type: 'bye' }); });
  Object.values(calls).forEach(c => c.close());
  Object.values(screenCallsOut).forEach(c => c.close());
  Object.values(screenCallsIn).forEach(c => c.close());
  Object.values(dataConns).forEach(c => c.close());
  if (localStream) localStream.getTracks().forEach(t => t.stop());
  if (screenStream) screenStream.getTracks().forEach(t => t.stop());
  if (peer) peer.destroy();
}

$('leaveBtn').onclick = () => { leaveRoom(); setTimeout(() => location.reload(), 150); };
window.addEventListener('beforeunload', leaveRoom);
</script>
